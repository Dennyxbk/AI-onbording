# ---------- LLM ----------
# основной провайдер: yandex | ollama | deepseek | claude | openai | none
LLM_PROVIDER=yandex
# запасные через запятую, пробуются по порядку, если основной недоступен
LLM_FALLBACK=ollama
# LLM_MODEL=              # переопределить модель основного провайдера

# Yandex AI Studio (основной вариант, данные в РФ-облаке)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt/latest        # или yandexgpt-lite/latest
# YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1

# Ollama (свой контур): ollama serve && ollama pull qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Claude (Anthropic)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_EFFORT=low

# OpenAI / ChatGPT
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------- ML-роутер Laya ----------
# LAYA_OFF=1                 # заглушка на ключевых словах вместо модели
# LAYA_MODEL=multilingual    # multilingual (рус.) | typed-decisions | "" (english)
# HF_HOME=D:\hf_cache        # куда скачивать веса
# MIN_CONFIDENCE=0.70

# ---------- Telegram ----------
TG_TOKEN=
HR_CHAT_ID=
# SECURITY_CHAT_ID=

# ---------- Защита базы знаний ----------
# VAULT_REVIEW=1             # 0 — использовать неодобренные (но чистые) заметки; для прода не выключать
# VAULT_STALE_DAYS=180       # предупреждать о заметках, которые давно не обновлялись
# VAULT_TRUSTED_DOMAINS=example\.com   # регулярка доверенных доменов для ссылок в заметках

# ---------- Маршрут и напоминания ----------
# REMIND_AT=10:00            # время ежедневной рассылки (время сервера)
# REMIND_AHEAD_DAYS=2        # за сколько дней предупреждать об этапе
# ESCALATE_AFTER_DAYS=3      # просрочка обязательного этапа → эскалация в HR
